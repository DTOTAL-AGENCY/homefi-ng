# ---- Web (apps/web/.env.local) and worker (apps/worker/.env) ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (pnpm db:start prints local values)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Signs email confirmation and review links (any long random string in production)
APP_SECRET=

# Email: log | smtp | resend   (local: smtp → Mailpit at http://127.0.0.1:54324)
EMAIL_TRANSPORT=smtp
SMTP_URL=smtp://127.0.0.1:54325
RESEND_API_KEY=
EMAIL_WEBHOOK_SECRET=
EMAIL_FROM=HomeFi Advisory Team <support@homefi.ng>
EMAIL_REPLY_TO=support.homefi@gmail.com
OPS_ALERT_EMAIL=

# Claude writes the report narrative (words only). Without a key the worker uses rule-based wording.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Paystack (test keys on staging). Without a key, a local mock checkout is used.
PAYSTACK_SECRET_KEY=

# Cal.com API v2. Without a key, a mock calendar (weekdays 09:00-17:00 WAT) is used.
CAL_API_KEY=
CAL_WEBHOOK_SECRET=

# Cloudflare Turnstile (skipped outside production when unset)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Staff two-factor: defaults to on in production
REQUIRE_STAFF_MFA=
